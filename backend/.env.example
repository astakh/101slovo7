# ─── Database ─────────────────────────────────────────────────────────
# Формат: postgresql://user:password@host:port/database
# Поддерживаются также: postgresql+asyncpg://, postgresql+psycopg://, postgres://
# (диалекты автоматически нормализуются для psycopg 3)
DATABASE_URL=postgresql://user:password@localhost:5432/101slovo

# ─── JWT & Auth ───────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-strong-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=30

# ─── GigaChat LLM ────────────────────────────────────────────────────
GIGACHAT_AUTH_KEY=your-auth-key-here
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
GIGACHAT_MAX_CONCURRENCY=5
GIGACHAT_TOKEN_REFRESH_MINUTES=10
# Отключите проверку SSL для разработки (False) или включите для продакшена (True)
# При False не требуется установка сертификатов НУЦ Минцифры
GIGACHAT_VERIFY_SSL=False

# ─── LLM Generation Params ───────────────────────────────────────────
GEN_TEMPERATURE=0.7
EVAL_TEMPERATURE=0.2
LLM_LOG_RETENTION_DAYS=90

# ─── App Limits ──────────────────────────────────────────────────────
DEFAULT_DICTIONARY_CODE=general
WORDS_PER_LESSON_DEFAULT=5
DAILY_LESSON_LIMIT_DEFAULT=1

# ─── CORS ─────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
